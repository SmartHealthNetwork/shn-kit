# tools/kitassets/pins.env — single source for the pins build.sh and manifest.sh
# both need (duplicated constants would drift silently otherwise; one file, sourced).
# jlink.sh keeps its own per-target archive sha256 table but sources TEMURIN_RELEASE.
HAPI_DIGEST="hapiproject/hapi@sha256:1be4d7ffe7a35a9fb46151851e5a20b25c5016f16c8ef8b59b0c807ad06a40c1"
# br-provider: the Kit bundles the CORRECTED reference provider — the pinned upstream
# commit plus the reviewed correction series in tools/brprovider/patches, built by
# tools/brprovider/build-corrected.sh. Its identity (upstream pin + image tag) has one
# source, tools/brprovider/source.env, shared with every other consumer of that image;
# it is sourced here, never copied. The uncorrected upstream tag br-provider:43a4806
# reads the DTR package only under `packagebundle` and is not what the Kit ships.
# shellcheck source=tools/brprovider/source.env
. "$(dirname "${BASH_SOURCE[0]}")/../brprovider/source.env"
BRP_IMAGE="br-provider:${BRPROVIDER_IMAGE_TAG}"
TEMURIN_RELEASE="21.0.11+10"
