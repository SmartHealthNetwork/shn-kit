+
+describe("package Bundle parameter names", () => {
+  function bundleWithQ(canonical: string): Bundle {
+    const q: Questionnaire = {
+      resourceType: "Questionnaire",
+      url: canonical,
+      status: "active",
+    };
+    return { resourceType: "Bundle", type: "collection", entry: [{ resource: q }] };
+  }
+
+  function paramsNamed(...named: [string, Bundle][]): Parameters {
+    return {
+      resourceType: "Parameters",
+      parameter: named.map(([name, resource]) => ({ name, resource })),
+    };
+  }
+
+  it("reads both published names and no other", () => {
+    expect(isPackageBundleParameter("packagebundle")).toBe(true);
+    expect(isPackageBundleParameter("PackageBundle")).toBe(true);
+    for (const other of ["packageBundle", "PACKAGEBUNDLE", "return", "outcome", "", undefined]) {
+      expect(isPackageBundleParameter(other)).toBe(false);
+    }
+  });
+
+  it("unwraps a DTR 2.0.1 PackageBundle parameter", () => {
+    const inner = bundleWithQ("http://example.org/Q/A");
+    expect(extractPackageBundle(paramsNamed(["PackageBundle", inner]))).toBe(inner);
+  });
+
+  it("filters by canonical across both names", () => {
+    const a = bundleWithQ("http://example.org/Q/A");
+    const b = bundleWithQ("http://example.org/Q/B");
+    expect(
+      extractPackageBundle(
+        paramsNamed(["packagebundle", a], ["PackageBundle", b]),
+        "http://example.org/Q/B",
+      ),
+    ).toBe(b);
+    expect(
+      extractPackageBundle(
+        paramsNamed(["PackageBundle", a], ["packagebundle", b]),
+        "http://example.org/Q/Missing",
+      ),
+    ).toBe(a);
+  });
+
+  it("still returns null for a Bundle under any other name", () => {
+    const inner = bundleWithQ("http://example.org/Q/A");
+    for (const other of ["packageBundle", "PACKAGEBUNDLE", "return", "bundle"]) {
+      expect(extractPackageBundle(paramsNamed([other, inner]))).toBeNull();
+    }
+  });
+});
