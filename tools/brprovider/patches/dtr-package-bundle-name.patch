+import type { Bundle, Parameters } from "fhir/r4";
+import { describe, expect, it } from "vitest";
+import { deriveServerUrls } from "./use-questionnaire";
+
+function packageBundle(): Bundle {
+  return {
+    resourceType: "Bundle",
+    type: "collection",
+    entry: [
+      {
+        fullUrl: "http://payer.example/fhir/Library/Rules",
+        resource: { resourceType: "Library", status: "active", type: {} },
+      },
+      {
+        fullUrl: "http://terminology.example/fhir/ValueSet/codes",
+        resource: { resourceType: "ValueSet", status: "active" },
+      },
+    ],
+  };
+}
+
+function paramsNamed(name: string): Parameters {
+  return {
+    resourceType: "Parameters",
+    parameter: [{ name, resource: packageBundle() }],
+  };
+}
+
+describe("deriveServerUrls", () => {
+  const derived = {
+    contentServerUrl: "http://payer.example/fhir",
+    terminologyServerUrl: "http://terminology.example/fhir",
+  };
+  const none = { contentServerUrl: null, terminologyServerUrl: null };
+
+  it("reads the DTR 2.2.0 packagebundle parameter", () => {
+    expect(deriveServerUrls(paramsNamed("packagebundle"))).toEqual(derived);
+  });
+
+  it("reads the DTR 2.0.1 PackageBundle parameter", () => {
+    expect(deriveServerUrls(paramsNamed("PackageBundle"))).toEqual(derived);
+  });
+
+  it("derives nothing from a Bundle under any other name", () => {
+    for (const other of ["packageBundle", "PACKAGEBUNDLE", "return", "outcome"]) {
+      expect(deriveServerUrls(paramsNamed(other))).toEqual(none);
+    }
+  });
+
+  it("still reads a direct Bundle", () => {
+    expect(deriveServerUrls(packageBundle())).toEqual(derived);
+  });
+});
