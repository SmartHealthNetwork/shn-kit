 import type { Bundle, ParametersParameter, Questionnaire } from "fhir/r4";
 
+/**
+ * Whether a `$questionnaire-package` output parameter carries a package Bundle.
+ * DTR 2.2.0 names it `packagebundle`; the DTR 2.0.1 and 2.1.0 output profiles
+ * name it `PackageBundle`. Both published names are read; no other name is.
+ */
+export function isPackageBundleParameter(name: string | undefined): boolean {
+  return name === "packagebundle" || name === "PackageBundle";
+}
