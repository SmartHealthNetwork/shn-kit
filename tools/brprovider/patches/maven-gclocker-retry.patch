 ##########################################################################
 FROM docker.io/library/maven:3.9.11-eclipse-temurin-17 AS build-server
 
+# The war plugin's parallel zip threads hold the JVM's GC locker, and JDK 17 gives up on an
+# allocation blocked by it after a few retries (GCLockerRetryAllocationCount, default 2),
+# failing it as "Java heap space" with the heap far from full. Both Maven builds of the WAR,
+# in this stage and in the packaging stage built from it, retry up to 100 times instead.
+ENV MAVEN_OPTS="-XX:+UnlockDiagnosticVMOptions -XX:GCLockerRetryAllocationCount=100"
+
 WORKDIR /tmp/hapi-fhir-jpaserver-starter
 
